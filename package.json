{
  "author": "ksugawara61",
  "bin": {
    "canvas-comments-board-resolve": "./dist/cli/board-resolve.js",
    "canvas-comments-dom-map": "./dist/cli/dom-map.js",
    "canvas-comments-reply": "./dist/cli/reply.js",
    "canvas-comments-wait-board": "./dist/cli/wait-board.js",
    "canvas-comments-wait-comments": "./dist/cli/wait-comments.js"
  },
  "bugs": {
    "url": "https://github.com/ksugawara61/storybook-addon-canvas-comments/issues"
  },
  "dependencies": {
    "dom-accessibility-api": "^0.6.3"
  },
  "description": "Storybook addon for inline UI feedback on the canvas — click to annotate, compare stories on a board, review in a panel, and hand structured context to coding agents via a filesystem dom-map.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "@storybook/icons": "2.2.0",
    "@types/node": "25.2.0",
    "@types/react": "^19.3.0",
    "jsdom": "^28.0.0",
    "react": "19.3.0",
    "storybook": "10.6.6",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "dist",
    "README.md",
    "src/board/board-items.ts",
    "src/board/board-schema.ts",
    "src/cloudflare",
    "src/comment-schema.ts",
    "src/constants.ts",
    "src/review-schema.ts",
    "src/storage",
    "src/types.ts",
    "!src/**/*.test.ts"
  ],
  "homepage": "https://github.com/ksugawara61/storybook-addon-canvas-comments#readme",
  "keywords": [
    "storybook-addon",
    "canvas",
    "ui-feedback",
    "ai-agent",
    "design-review",
    "dom-map",
    "board"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "storybook-addon-canvas-comments",
  "packageManager": "pnpm@11.1.2",
  "peerDependencies": {
    "react": ">=18",
    "storybook": ">=8",
    "typescript": ">=5",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksugawara61/storybook-addon-canvas-comments.git"
  },
  "scripts": {
    "board-resolve": "tsx src/cli/board-resolve.ts",
    "build": "tsup",
    "dom-map": "tsx src/cli/dom-map.ts",
    "reply": "tsx src/cli/reply.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/cloudflare/tsconfig.json",
    "wait-board": "tsx src/cli/wait-board.ts",
    "wait-comments": "tsx src/cli/wait-comments.ts",
    "prepack": "tsup"
  },
  "storybook": {
    "displayName": "Canvas Comments",
    "icon": "https://raw.githubusercontent.com/storybookjs/storybook/main/code/addons/comment.svg",
    "supportedFrameworks": [
      "react"
    ]
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.3.7"
}
